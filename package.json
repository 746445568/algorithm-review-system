{
  "name": "algorithm-review-system",
  "description": "OJ review desktop app with Electron, React, Vite, and Go",
  "private": true,
  "scripts": {
    "desktop:dev": "npm run dev --prefix apps/desktop-electron",
    "desktop:renderer": "npm run dev:renderer --prefix apps/desktop-electron",
    "desktop:build": "npm run build --prefix apps/desktop-electron",
    "desktop:dist": "npm run dist --prefix apps/desktop-electron",
    "desktop:start": "npm run start --prefix apps/desktop-electron",
    "server:dev": "cd apps/server && go run ./cmd/ojreviewd",
    "server:test": "cd apps/server && go test ./..."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "electron",
    "react",
    "go",
    "sqlite",
    "codeforces"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@lydell/node-pty-win32-x64": "^1.2.0-beta.12"
  }
}
