# OJ Review Desktop - Environment Variables
# Most settings are configured via the desktop Settings UI.
# These are optional overrides for development.

# Go service port (default: 38473, localhost only)
OJREVIEW_SERVICE_PATH=

# Optional LLM configuration (also configurable via Settings UI)
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
